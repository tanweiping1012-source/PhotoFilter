    "AI评分进行中，不能同时发起另一项评分。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AI scoring is active. Another scoring task cannot start at the same time."
          }
        }
      }
    },
    "AI评分进行中；停止本轮任务后即可新建或切换项目。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AI scoring is running. Stop this run to create or switch projects."
          }
        }
      }
    },
    "AI评分进行中；请先停止本轮任务再修改人工决定。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AI scoring is active. Stop it before changing manual decisions."
          }
        }
      }
    },
    "AI评分进行中；请先停止本轮任务再撤销人工决定。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AI scoring is active. Stop it before undoing manual decisions."
          }
        }
      }
    },
