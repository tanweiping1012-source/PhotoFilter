      }
    },
    "8 张 · 示例筛选": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "8 photos · Example curation"
          }
        }
      }
    },
    "AI %lld 分": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AI %lld"
          }
        }
      }
    },
    "AI 供应商 API Key": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AI Provider API Keys"
          }
        }
      }
    },
    "AI 服务当前已限流或账户资源暂不可用（HTTP %lld%@）。请检查供应商的套餐额度或余额，并至少等待 1 分钟后重试。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The AI service is rate-limiting requests or account resources are temporarily unavailable (HTTP %1$lld%2$@). Check the provider plan quota or balance, and wait at least one minute before retrying."
          }
        }
      }
    },
    "AI 服务未返回要求的工具调用或 JSON 结果": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The AI service did not return the required tool call or JSON result"
          }
        }
      }
    },
    "AI 服务请求未成功（HTTP %lld%@）。请检查供应商、模型权限、模型 ID 或稍后重试。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AI service request failed (HTTP %1$lld%2$@). Check the provider, model access, and model ID, or try again later."
          }
        }
      }
    },
    "AI 服务返回的响应外层结构无法识别": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The AI service response envelope could not be recognized"
          }
        }
      }
    },
    "AI 服务返回的审美字段不完整或类型不符": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The AI service aesthetic fields are incomplete or have invalid types"
          }
        }
      }
    },
    "AI 服务返回的网络响应无法识别": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The AI service network response could not be recognized"
          }
        }
      }
    },
    "AI总结": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AI Summary"
          }
        }
      }
    },
    "AI评分": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AI Scoring"
          }
        }
      }
    },
    "AI评分包含照片间的相对比较，已要求模型重新独立评分。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AI scoring compared photos with each other, so the model was asked to score them independently again."
          }
        }
      }
    },
    "AI评分失败并停止：%@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AI scoring failed and stopped: %1$@"
          }
        }
      }
    },
    "AI评分已中断：%@ 已完成 %lld 张的评分已保留，可以从中断处继续。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AI Scoring was interrupted: %1$@ Scores for the %2$lld photos already completed are kept, and you can resume from there."
          }
        }
      }
    },
    "AI评分已停止；不会形成不完整的评分结果。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AI scoring stopped. No incomplete results will be created."
          }
        }
      }
    },
    "AI评分已停止；已完成照片的评分仍保留，但不会形成最终结果。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AI scoring stopped. Scores for completed photos remain, but no final result will be created."
          }
        }
      }
    },
    "AI评分已完成": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AI scoring complete"
          }
        }
      }
    },
    "AI评分已暂停；不会继续评估后面的照片。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AI scoring is paused. Later photos will not be evaluated."
          }
        }
      }
    },
    "AI评分已继续。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AI scoring resumed."
          }
        }
      }
    },
    "AI评分已评估 %lld / %lld 张。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AI scoring evaluated %1$lld of %2$lld photos."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "new",
            "value": "AI评分已评估 %1$lld / %2$lld 张。"
          }
        }
      }
    },
    "AI评分未生效：%@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AI scoring was not applied: %1$@"
          }
        }
      }
    },
    "AI评分结果不属于当前请求。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The AI scoring result does not belong to the current request."
          }
        }
      }
    },
    "AI评分结果不属于当前这些照片。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The AI scoring result does not belong to the current photos."
          }
        }
      }
    },
    "AI评分结果与当前候选照片不一致。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The AI scoring result does not match the current candidate photos."
          }
        }
      }
    },
    "AI评分结果仍包含多张画面相似照片，结果未生效。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The AI scoring result still contains multiple visually similar photos and was not applied."
          }
        }
      }
    },
    "AI评分结果包含不合法的维度分数。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The AI scoring result contains an invalid dimension score."
          }
        }
      }
    },
    "AI评分结果包含待评分范围外的照片，已停止应用结果。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AI scoring results contain a photo outside the scoring set. The results were not applied."
          }
        }
      }
    },
    "AI评分结果包含重复照片。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The AI scoring result contains duplicate photos."
          }
        }
      }
    },
    "AI评分结果包含重复照片，已停止应用结果。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AI scoring results contain duplicate photos. The results were not applied."
          }
        }
      }
    },
    "AI评分结果数量与保留目标不一致，已停止应用结果。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The AI scoring result count does not match the keep target. The results were not applied."
          }
        }
      }
    },
    "AI评分结果未覆盖全部候选照片，已停止应用结果。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AI scoring did not cover every candidate photo, so the result was not applied."
          }
        }
      }
    },
    "AI评分结果版本不受支持。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The AI scoring result version is not supported."
          }
        }
      }
    },
    "AI评分结果的总分不在 0–100 范围内。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The AI total score is outside the 0–100 range."
          }
        }
      }
    },
    "AI评分结果缺少可读的具体评价。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The AI scoring result is missing readable feedback."
          }
        }
      }
    },
    "AI评分结果缺少可读的总结。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The AI scoring result is missing a readable summary."
          }
        }
      }
