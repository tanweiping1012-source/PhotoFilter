    "诊断信息": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Diagnostic Information"
          }
        }
      }
    },
    "诊断信息仅包含 App 版本、macOS 版本和运行模式，不包含照片、文件路径或 API Key。": {
      "localizations": {
        "en": {
