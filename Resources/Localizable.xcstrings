          }
        }
      }
    },
    "%@中已有 %lld 组相似照片被同时保留；请先确认是否都要保留。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ already has %2$lld sets of similar photos kept together. Confirm whether all of them should be kept."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@中已有 %2$lld 组相似照片被同时保留；请先确认是否都要保留。"
          }
        }
      }
    },
    "%@保留进度": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ keep progress"
          }
        }
      }
    },
    "%@没有可评分的照片。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ has no photos to score."
          }
        }
      }
    },
    "%@的照片都已保留或淘汰，没有需要评分的照片。": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every %@ photo is already kept or rejected, so there is nothing left to score."
          }
        }
      }
    },
    "%@第 %lld 名": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ rank %2$lld"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@第 %2$lld 名"
          }
        }
      }
    },
    "%@连接成功；图片输入和评分结果均已验证。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ connected successfully. Image input and scoring output were both verified."
          }
        }
      }
    },
    "%@，已丢弃本次评分。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@. This scoring result was discarded."
